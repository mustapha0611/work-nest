# Local development values only. Never reuse these credentials outside local dev.

# Docker Compose PostgreSQL
POSTGRES_USER=worknest
POSTGRES_PASSWORD=worknest_dev_only
POSTGRES_DB=worknest
POSTGRES_PORT=5432

# Backend runtime (copy these into backend/.env when the backend is scaffolded)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL connection URLs
DATABASE_URL=postgresql://worknest:worknest_dev_only@localhost:5432/worknest?schema=public
TEST_DATABASE_URL=postgresql://worknest:worknest_dev_only@localhost:5432/worknest_test?schema=public

# Authentication
SESSION_COOKIE_NAME=wn_session
SESSION_TTL_DAYS=7
APP_ORIGIN=http://localhost:4200

# Only set this when the API is behind a trusted reverse proxy
# TRUST_PROXY=1
